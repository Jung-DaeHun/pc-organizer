{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-commit-verify.mjs\"",
            "timeout": 300,
            "statusMessage": "커밋 전 검사 (린트 · 타입 · 테스트 · 빌드)"
          }
        ]
      }
    ]
  }
}
